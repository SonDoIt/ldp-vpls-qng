# Copy to .env.local (dev) or the server's environment (production). Never commit real values.

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add widget, add the site's domain).
# The values below are Cloudflare's test keys: they always pass and work on localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Outgoing mail for the contact form. Gmail: turn on 2-Step Verification on the account, then
# create an App Password (https://myaccount.google.com/apppasswords) and paste it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vpthadsquangngai@gmail.com
SMTP_PASS=

# Inbox that receives requests. Defaults to SMTP_USER.
CONTACT_TO=
